{
  "name": "medinova-ehr",
  "version": "0.1.0",
  "private": true,
  "description": "Clickable front-end prototype for a data-dense EHR/EMR. Vanilla HTML/CSS/JS + native Web Components. Playwright is dev tooling only and is never imported by prototype code.",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server . -p 4173 -c-1 --silent",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test --update-snapshots",
    "test:a11y": "playwright test --grep @a11y",
    "test:tokens": "playwright test tests/specs/tokens.spec.js",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.0",
    "http-server": "^14.1.1"
  }
}
